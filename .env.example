# ─────────────────────────────────────────────────────────────────────────
# GECODIS CRM — Environment configuration
# Copy this file to `.env` at the repo root AND to apps/api/.env, then fill
# in the values you have. Every external integration is optional: when a
# key is missing the corresponding service automatically falls back to a
# safe mock/heuristic implementation so the app keeps working end to end.
# ─────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://gecodis:gecodis@localhost:5432/gecodis_crm?schema=public"

# --- Redis / Queues (BullMQ) --------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Separate secret for client-portal tokens (apps/api/src/portal/) — keeps portal
# sessions cryptographically isolated from staff sessions. Falls back to JWT_SECRET if unset.
PORTAL_JWT_SECRET="change-me-portal-secret"
MFA_ISSUER="Gecodis CRM"
# OAuth (optional — Google Workspace SSO)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI (OpenAI) ----------------------------------------------------------
# Powers company/contact scoring, the "IA commerciale" assistant, and
# enrichment summarisation. Without a key the app uses deterministic
# heuristic scoring instead (see apps/api/src/ai/heuristics.ts) so the
# product is fully demo-able offline.
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4.1"

# --- Company data enrichment providers ------------------------------------
# All are optional. Each provider is implemented behind a common
# `CompanyDataProvider` interface (apps/api/src/enrichment/providers) —
# add a key to enable it, the enrichment pipeline picks it up automatically.
INSEE_SIRENE_CONSUMER_KEY=
INSEE_SIRENE_CONSUMER_SECRET=
PAPPERS_API_KEY=
INPI_API_TOKEN=
SOCIETE_COM_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
LINKEDIN_SCRAPER_API_KEY=
# Proxycurl-compatible base URL — override to point at another compliant provider.
LINKEDIN_SCRAPER_BASE_URL="https://nubela.co/proxycurl/api"

# --- Storage (S3-compatible) ----------------------------------------------
S3_ENDPOINT=
S3_REGION="eu-west-3"
S3_BUCKET="gecodis-crm"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Search -----------------------------------------------------------------
# "postgres" (default, zero-config) or "elasticsearch"
SEARCH_PROVIDER="postgres"
ELASTICSEARCH_NODE="http://localhost:9200"

# --- Transactional & campaign email ---------------------------------------
EMAIL_PROVIDER="console"   # console | resend | sendgrid | smtp
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Gecodis CRM <crm@gecodis.fr>"

# --- E-signature (quotes) --------------------------------------------------
ESIGNATURE_PROVIDER="mock"  # mock | docusign | yousign
DOCUSIGN_API_KEY=
YOUSIGN_API_KEY=

# --- Third-party ERP / WMS / billing connectors ----------------------------
# Outbound: the CRM POSTs events (customer created, quote signed, deal won) to
# these URLs, signed with HMAC-SHA256 (header X-Gecodis-Signature) using the
# matching *_WEBHOOK_SECRET below. Leaving a URL empty just skips that connector.
BILLING_SOFTWARE_WEBHOOK_URL=
BILLING_SOFTWARE_WEBHOOK_SECRET=
WMS_WEBHOOK_URL=
WMS_WEBHOOK_SECRET=
# Inbound: point your billing software / WMS at
# POST {API_URL}/api/webhooks/billing and POST {API_URL}/api/webhooks/wms,
# signing their payloads with the same secrets above.
